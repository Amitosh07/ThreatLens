# Copy this file to backend/.env and restart the API after changes.
# Environment variables use the THREATLENS_ prefix.

# SQLite database. Relative paths are resolved from the backend directory.
THREATLENS_DATABASE_URL=sqlite:///./threatlens.db

# Uploaded captures are stored here, outside the frontend. Relative to backend/.
THREATLENS_STORAGE_DIR=./storage

# Maximum upload size in bytes. Default is 50 MB.
THREATLENS_MAX_UPLOAD_BYTES=52428800

# Stop processing a capture after this many packets. Results are partial and say so.
THREATLENS_MAX_PACKETS=100000

# Soft time limit for one analysis, in seconds.
THREATLENS_MAX_PROCESSING_SECONDS=300

# Full path to tshark.exe. Leave blank to try PATH and the default Wireshark location.
# Common Windows path:
THREATLENS_TSHARK_PATH=C:\Program Files\Wireshark\tshark.exe

# Comma-separated browser origins allowed to call the API directly.
THREATLENS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
